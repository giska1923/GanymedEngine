<rml>
<head>
	<title>Proving Ground HUD</title>
	<!-- rml.rcss first: it supplies the element defaults RmlUi does not ship
	     (notably div { display: block }). Without it every box collapses. -->
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="hud.rcss"/>
</head>
<!-- data-model="hud" binds to the model UIEngine creates in Init. It must exist
     before this document loads, or the {{expressions}} render as literal text.

     The model has exactly two variables, health and score, declared in C++ before
     any document loads. A game cannot add a third from here - see
     docs/ToDo/cross-cutting.md. That is why the weapon level and the enemy count,
     both of which the Proving Ground tracks, are not on this HUD. -->
<body id="hud" data-model="hud">
	<div id="health-bar">
		<div id="health-fill" data-style-width="health + '%'"></div>
		<span id="health-text">{{health | round}} / 100</span>
	</div>
	<div id="score">SCORE {{score}}</div>

	<!-- Two divs rather than a texture: the crosshair is the one piece of this HUD
	     that has to sit exactly in the middle of the viewport at any window size,
	     and a 2dp box centred with a negative margin does that without an asset. -->
	<div id="crosshair">
		<div id="crosshair-h"></div>
		<div id="crosshair-v"></div>
	</div>
</body>
</rml>
