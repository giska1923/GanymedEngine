# GitHub
.github/

# Binaries
**/bin/
bin/
# That covers vendor/premake/bin/ too: scripts/setup.py downloads premake per machine.

# Assets - one tree, assets/ at the root, shared by the editor and the runtime.
# AssetRegistry.gr is the legacy identity file; the .meta sidecars replaced it and a local one
# is read only as a migration seed. .assets is the abandoned pre-sidecar mesh cache.
assets/AssetRegistry.gr
assets/.assets

# Compiled asset outputs - block-compressed textures and binary mesh blobs, keyed by a hash
# of the source path. Derived from committed sources and rebuilt on demand, so it is ignored
# in every project rather than per app; deleting the tree costs one recompile.
**/assets/.compiled/

# Premake-generated makefiles (regenerate with scripts/setup.py)
Makefile
*.make

# Always track premake5.lua files (build configuration)
!**/premake5.lua

# Build artifacts in extern folders
**/extern/**/bin/
**/extern/**/bin-int/
**/extern/**/temp/
**/extern/**/*.vcxproj
**/extern/**/*.vcxproj.filters
**/extern/**/*.vcxproj.user
**/extern/**/*.lib
**/extern/**/*.pdb
**/extern/**/*.obj

# But keep the main extern submodule folders tracked
!**/extern/*/
!**/extern/*/.git

# Temporary build folders
temp/

# Locally built bgfx tools (the shadertools step of scripts/setup.py)
scripts/tools/

# Compiled shader bytecode - derived from assets/shaders/src/*.sc.
# Regenerate with `python scripts/setup.py shaders` after any shader edit.
**/assets/shaders/compiled/

# GanymedE files
*.log
*.tlog
*.json

# The blanket *.json above would swallow the TypeScript authoring project's config, which is
# build configuration and must be tracked. Negations must be file-by-file: a re-include cannot
# resurrect a path whose parent directory was excluded, so keep these narrow and explicit.
!GanymedEditor/scripts-src/package.json
!GanymedEditor/scripts-src/package-lock.json
!GanymedEditor/scripts-src/tsconfig.json

# npm dependencies for the TypeScript -> Lua toolchain (restore with `npm install`)
node_modules/

# Visual Studio files and folder
.vs/
**.sln
**.vcxproj
**.vcxproj.filters
**.vcxproj.user
vs-chromium-project.txt

# Xcode projects, generated by scripts/setup.py like the .sln and
# makefiles above. Only applies to this repo - submodules keep their own index, so
# the example .xcodeproj that imgui and friends ship stay tracked.
*.xcodeproj/
*.xcworkspace/
xcuserdata/

# ImGui settings
imgui.ini

*.exe
*.idb
*.idj
*.ilk
*.lib
*.obj
*.pch
*.pdb